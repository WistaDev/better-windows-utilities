<UserControl x:Class="BWU.Views.MaintenanceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:util="clr-namespace:BWU.Utilities">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="240"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">
                <ItemsControl ItemsSource="{Binding Operations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource H3}"/>
                                            <TextBlock Text="{Binding AdminBadge}" Foreground="{DynamicResource WarningBrush}" FontSize="11.5" Margin="10,3,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Run" Style="{StaticResource PrimaryButton}" Margin="0" MinWidth="80" VerticalAlignment="Center"
                                            Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Windows Update and restore shortcuts" Style="{StaticResource H3}" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <ItemsControl ItemsSource="{Binding UpdateShortcuts}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Title}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                                Command="{Binding DataContext.OpenUriCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Uri}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Open System Restore" Command="{Binding OpenRestoreCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,4,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" IsIndeterminate="{Binding IsIndeterminate}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="12,4"/>
            <Button Grid.Column="2" Content="Clear output" Command="{Binding ClearLogCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="12,4"/>
        </Grid>

        <TextBox Grid.Row="2" Text="{Binding Log.Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" util:TextBoxBehavior.AutoScroll="True" AcceptsReturn="True"/>
    </Grid>
</UserControl>
