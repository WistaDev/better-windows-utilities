<UserControl x:Class="BWU.Views.OptimizationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,0">
            <TextBlock Text="Optimization profiles" Style="{StaticResource H2}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                       Text="Profiles apply a group of the settings below. Every change is explained first, backed up, and can be reverted."/>
            <ItemsControl ItemsSource="{Binding Profiles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H3}"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Apply profile" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}"/>
                                    <Button Content="Revert" Command="{Binding RevertCommand}" Style="{StaticResource SecondaryButton}" Margin="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding ProfileMessage}" Style="{StaticResource Muted}" Margin="0,0,0,12"/>

            <TextBlock Text="Performance settings" Style="{StaticResource H2}" Margin="0,8,0,8"/>
            <ItemsControl ItemsSource="{Binding Tweaks}"/>

            <Grid Margin="0,8,0,8">
                <TextBlock Text="Startup apps" Style="{StaticResource H2}" Margin="0"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Margin="0"/>
            </Grid>
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                       Text="Entries from the Windows Run keys. Disabling works like Task Manager's Startup tab: nothing is deleted. Suggestions are heuristics, not verdicts."/>
            <ItemsControl ItemsSource="{Binding StartupItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource H3}"/>
                                        <TextBlock Text="{Binding StateText}" Style="{StaticResource Muted}" Margin="10,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Command}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Command}"/>
                                    <TextBlock Text="{Binding Location}" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource WarningBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Visibility="{Binding Hint, Converter={StaticResource StringToVis}}"/>
                                    <TextBlock Text="{Binding Result}" Style="{StaticResource Muted}" Margin="0,4,0,0" Visibility="{Binding Result, Converter={StaticResource StringToVis}}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" Style="{StaticResource SecondaryButton}" Margin="0" MinWidth="90" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Background services" Style="{StaticResource H2}" Margin="0,8,0,8"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                       Text="Only a short, reviewed list of optional services is shown. Critical Windows services are never listed or changed. Setting a service to Manual does not disable it."/>
            <ItemsControl ItemsSource="{Binding Services}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H3}"/>
                                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Result}" Style="{StaticResource Muted}" Margin="0,4,0,0" Visibility="{Binding Result, Converter={StaticResource StringToVis}}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Content="Set to Manual" Command="{Binding ManualCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"/>
                                    <Button Content="Restore" Command="{Binding RestoreCommand}" Style="{StaticResource SecondaryButton}" Margin="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Margin="0,8,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Clean temporary files" Style="{StaticResource H3}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Temporary file cleanup lives in BWU More Spaces, together with Compact OS and storage analysis."/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open More Spaces" Command="{Binding OpenMoreSpacesCommand}" Style="{StaticResource PrimaryButton}" Margin="0" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
