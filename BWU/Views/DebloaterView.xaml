<UserControl x:Class="BWU.Views.DebloaterView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                       Text="Apps are listed for the current user. Optional apps can be removed; Windows components and dependencies are protected and cannot be selected."/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search apps"/>
                <CheckBox Grid.Column="1" Content="Show protected components" IsChecked="{Binding ShowProtected}" Margin="14,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"/>
                <Button Content="Select optional apps" Command="{Binding SelectOptionalCommand}" Style="{StaticResource SecondaryButton}"/>
                <Button Content="Clear selection" Command="{Binding ClearSelectionCommand}" Style="{StaticResource SecondaryButton}"/>
                <Button Content="{Binding RemoveText}" Command="{Binding RemoveCommand}" Style="{StaticResource DangerButton}"/>
            </StackPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Apps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding PackageFullName}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding PackageFullName}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding CategoryText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0" MaxHeight="150"
                Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Margin="0,2">
                                <Run Text="{Binding Operation, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" — "/><Run Text="{Binding Detail, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
