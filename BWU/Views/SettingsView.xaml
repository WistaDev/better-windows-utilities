<UserControl x:Class="BWU.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,0">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Application theme" Style="{StaticResource H3}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Dark + Blue" GroupName="theme" IsChecked="{Binding IsDark, Mode=TwoWay}" Style="{StaticResource ChoiceButton}"/>
                        <RadioButton Content="Light + Blue" GroupName="theme" IsChecked="{Binding IsLight, Mode=TwoWay}" Style="{StaticResource ChoiceButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Language" Style="{StaticResource H3}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="English" GroupName="lang" IsChecked="{Binding IsEnglish, Mode=TwoWay}" Style="{StaticResource ChoiceButton}"/>
                        <RadioButton Content="Português (Brasil)" GroupName="lang" IsChecked="{Binding IsPortuguese, Mode=TwoWay}" Style="{StaticResource ChoiceButton}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                               Text="In version 1.0 the language applies to navigation and page headers. Page content is English only."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Startup behavior" Style="{StaticResource H3}" Margin="0,0,0,8"/>
                    <CheckBox Content="Start BWU when I sign in to Windows" IsChecked="{Binding StartWithWindows, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Update checking" Style="{StaticResource H3}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,8"
                               Text="BWU checks an HTTPS update manifest you configure: {&quot;version&quot;:&quot;1.1&quot;,&quot;url&quot;:&quot;https://…&quot;}. Nothing is downloaded or installed automatically."/>
                    <TextBox Text="{Binding UpdateUrl, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Check for updates" Command="{Binding CheckUpdatesCommand}" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="Open download page" Command="{Binding OpenDownloadCommand}" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Administrator status" Style="{StaticResource H3}"/>
                    <TextBlock Text="{Binding AdminText}" Style="{StaticResource Muted}" Margin="0,4,0,8"/>
                    <Button Content="Restart as administrator" Command="{Binding RestartAdminCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="About BWU" Style="{StaticResource H3}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding AppName}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Slogan}" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,8"/>
                    <TextBlock Style="{StaticResource Muted}"><Run Text="Version: "/><Run Text="{Binding Version, Mode=OneWay}"/></TextBlock>
                    <TextBlock Style="{StaticResource Muted}"><Run Text="Developer: "/><Run Text="{Binding Developer, Mode=OneWay}"/></TextBlock>
                    <TextBlock Style="{StaticResource Muted}"><Run Text="Runtime: "/><Run Text="{Binding Runtime, Mode=OneWay}"/></TextBlock>
                    <TextBlock Style="{StaticResource Muted}"><Run Text="Data folder (settings and backups): "/><Run Text="{Binding DataFolder, Mode=OneWay}"/></TextBlock>
                    <TextBlock Text="{Binding Copyright}" Style="{StaticResource Muted}" Margin="0,4,0,8"/>
                    <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
