<Application x:Class="BWU.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BWU.ViewModels"
             xmlns:v="clr-namespace:BWU.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 must stay the colour dictionary: ThemeService swaps it at runtime. -->
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SystemInfoViewModel}"><v:SystemInfoView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:OptimizationViewModel}"><v:OptimizationView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DebloaterViewModel}"><v:DebloaterView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CustomizationViewModel}"><v:CustomizationView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PackageManagerViewModel}"><v:PackageManagerView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:MaintenanceViewModel}"><v:MaintenanceView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:MoreSpacesViewModel}"><v:MoreSpacesView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PrivacyViewModel}"><v:PrivacyView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>

            <!-- One card per registry setting (used by Optimization, Privacy and Customization) -->
            <DataTemplate DataType="{x:Type vm:TweakItemViewModel}">
                <Border Style="{StaticResource Card}" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource H3}"/>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0">
                                <Run Text="Effect: " FontWeight="SemiBold"/><Run Text="{Binding Consequence, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="Requires administrator rights." Style="{StaticResource Muted}" Margin="0,6,0,0"
                                       Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" FontSize="12.5" Text="{Binding StatusText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ResultText}" Style="{StaticResource Muted}" Margin="0,4,0,0"
                                       Visibility="{Binding ResultText, Converter={StaticResource StringToVis}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="Apply" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" MinWidth="90"/>
                            <Button Content="Revert" Command="{Binding RevertCommand}" Style="{StaticResource SecondaryButton}" Margin="0" MinWidth="90"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
