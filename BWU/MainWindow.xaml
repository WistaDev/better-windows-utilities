<Window x:Class="BWU.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BWU — Better Windows Utilities" Width="1200" Height="780" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13.5"
        TextElement.Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        SizeChanged="OnSizeChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarWidth}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{DynamicResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,22,12,18">
                    <Image Source="Assets/Images/bwu.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding ShowLabels, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="BWU" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Make Windows Better." FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                    </StackPanel>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding NavItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                         Content="{Binding Title}" Tag="{Binding Glyph}" ToolTip="{Binding Title}"
                                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" Margin="28,22,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="{Binding CurrentTitle}" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding CurrentSubtitle}" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0"/>
            </StackPanel>
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel, NotifyOnTargetUpdated=True}" IsTabStop="False">
                <ContentControl.Triggers>
                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </ContentControl.Triggers>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
