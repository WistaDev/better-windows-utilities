<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark + Blue (default) -->
    <SolidColorBrush x:Key="BgBrush" Color="#10141D"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#151C29"/>
    <SolidColorBrush x:Key="CardBrush" Color="#1C2636"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#243249"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#1685E8"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#331685E8"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F2F5FA"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#A0AEC0"/>
    <SolidColorBrush x:Key="LineBrush" Color="#2A3850"/>
    <SolidColorBrush x:Key="InputBrush" Color="#141B28"/>
    <SolidColorBrush x:Key="ButtonBrush" Color="#2A3850"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3A4B66"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#3FB950"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#E3B341"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F85149"/>
</ResourceDictionary>
