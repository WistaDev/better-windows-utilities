<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light + Blue (optional) -->
    <SolidColorBrush x:Key="BgBrush" Color="#F3F6FB"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#E7EDF6"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#EEF3FA"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#1685E8"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#261685E8"/>
    <SolidColorBrush x:Key="TextBrush" Color="#10141D"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#5B6778"/>
